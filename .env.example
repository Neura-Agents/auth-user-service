PORT=3000
FRONTEND_URL=http://localhost:8080
SESSION_SECRET=<session_secret>

# Keycloak public client for main login
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/agentic-ai
KEYCLOAK_PUBLIC_ISSUER_URL=http://localhost:8081/realms/agentic-ai
KEYCLOAK_CLIENT_ID=auth-client
KEYCLOAK_CLIENT_SECRET=<keyclock_client_secret|null>
REDIRECT_URI=http://localhost:8000/backend/auth/callback
KEYCLOAK_REDIRECT_URI=http://localhost:8000/backend/auth/callback

# Keycloak admin client for registration
KEYCLOAK_ADMIN_CLIENT_ID=agentic-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=<keyclock_admin_client_secret>

# Database Setup
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=neura-agents-platform
